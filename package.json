{
  "name": "cloud-pm-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts tests/*.test.tsx",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "evaluate": "tsx src/cli.ts",
    "dev": "next dev -H 127.0.0.1",
    "demo": "DEMO_MODE=true DATA_DIR=./.data/demo next dev -H 127.0.0.1",
    "start": "next start -H 127.0.0.1",
    "sync": "node --env-file-if-exists=.env --import tsx src/sync.ts",
    "mcp:check": "node --env-file-if-exists=.env --import tsx src/mcp/check.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp/stdio.ts",
    "test:e2e": "playwright test",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
