# Copy to deploy/.env.external-db and chmod 600. Never commit real values.
DOMAIN=cloudpm.example.com
# Use the provider's connection string, with URL-encoded credentials and verified TLS.
DATABASE_URL=
# New installation: openssl rand -hex 32. Migration: preserve the existing key.
TOKEN_ENCRYPTION_KEY=
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WORKSPACE_ID=main
GITHUB_APP_WEBHOOK_SECRET=
# Callback: https://<DOMAIN>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional legacy PAT/webhook and server-side AI configuration.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_SYNC_SINCE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
