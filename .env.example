# PostgreSQL을 생략하면 로컬 PGlite를 DATA_DIR에 저장합니다.
# 여러 서버 프로세스를 동시에 사용할 때는 PostgreSQL을 설정하세요.
# DATABASE_URL=postgresql://cloudpm:cloudpm-local@localhost:5432/cloud_pm
DATA_DIR=./.data/cloud-pm

# 실제 조직 데이터 연동
GITHUB_ORG=
GITHUB_TOKEN=
# 생략하면 전체 이력. 지정하면 열린 작업 전체 + 해당 시각 이후 변경분 수집
# GITHUB_SYNC_SINCE=2026-09-21T00:00:00Z
# GitHub 웹훅 설정과 동일한 무작위 비밀키
GITHUB_WEBHOOK_SECRET=
# 조직 GitHub App 연동: 미설정 시 기존 PAT 방식 유지. 키는 채팅/저장소에 올리지 않습니다.
GITHUB_APP_ID=
# 선택: JWT issuer에 Client ID를 쓰는 경우 지정합니다.
GITHUB_APP_CLIENT_ID=
# 생략하면 GITHUB_ORG 조직의 설치 ID를 자동 조회합니다.
GITHUB_APP_INSTALLATION_ID=
# 내려받은 PEM 파일을 base64로 인코딩한 값. 또는 로컬 실행 시 KEY_PATH 사용.
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_PRIVATE_KEY_PATH=
# App이 공유될 워크스페이스. 다른 워크스페이스에는 자동 공유하지 않습니다.
GITHUB_APP_WORKSPACE_ID=main
# GitHub App 등록 화면의 Webhook secret. 기존 조직 웹훅 키와 별도로 관리합니다.
GITHUB_APP_WEBHOOK_SECRET=

# 서비스 접근 토큰 (GitHub 토큰과 다른 값)
# 각각 무작위 값으로 교체하세요. 비어 있으면 접근을 허용하지 않습니다.
APP_READ_TOKEN=
APP_WRITE_TOKEN=
APP_URL=http://127.0.0.1:3000

# AI 기능을 사용할 때만 설정. 실제 사용 가능한 모델 ID를 지정하세요.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 사용자 프로필의 GitHub 토큰 암호화용 32바이트 키 (64자리 hex). 변경 없이 백업하세요.
TOKEN_ENCRYPTION_KEY=
# 사용자 계정이 등록되면 기존 APP_READ_TOKEN/APP_WRITE_TOKEN은 기본 비활성화됩니다.
# ALLOW_LEGACY_ACCESS=true 는 초기 전환·로컬 점검에만 사용하세요.
# stdio MCP를 개인 프로필 권한으로 실행할 때 설정
# MCP_ACCESS_TOKEN=

# MCP CLI 연결 점검: 생략 시 APP_URL/api/mcp를 사용합니다.
# MCP_SERVER_URL=https://cloudpm.example.com/api/mcp
